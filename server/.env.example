PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/soc_recruitment
JWT_SECRET=<generate-a-long-random-string-min-32-chars>
CLIENT_URL=http://localhost:5173

# Cloudinary (image uploads — get from cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (transactional email — get from resend.com dashboard)
RESEND_API_KEY=

# Super Admin auto-provisioning (required in production — first-boot only)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
