# ==============================================================================
# Pulse Server Environment Configuration Template
# ==============================================================================
# Copy this file to `server/.env` and fill in the values below.

# --- Core Server Configuration ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database Configuration ---
# Provide a MongoDB connection URI (e.g. mongodb://127.0.0.1:27017/soc_recruitment or MongoDB Atlas URI).
# If left blank or connection fails in development, an in-memory MongoDB instance will automatically spin up.
MONGO_URI=mongodb://127.0.0.1:27017/soc_recruitment

# --- Authentication & Security ---
# Secret key used for signing JWT tokens (minimum 32 random characters recommended)
JWT_SECRET=

# --- Cloudinary (Media Uploads) ---
# Credentials obtained from your Cloudinary console dashboard (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend (Transactional Email Service) ---
# API key obtained from your Resend dashboard (https://resend.com)
# When omitted, outgoing emails gracefully fall back to server console logs.
RESEND_API_KEY=

# --- Super Admin Auto-Provisioning ---
# Used to seed/ensure an initial root super admin account upon server startup
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_USERNAME=
