# ==============================================================================
# Pulse Client Environment Configuration Template
# ==============================================================================
# Copy this file to `client/.env` and update values as needed for your environment.

# API Base URL pointing to the Express backend endpoint
# Development default: http://localhost:5000/api
# Production: Set to your deployed backend URL (e.g., https://your-backend-api.onrender.com/api)
VITE_API_URL=http://localhost:5000/api
